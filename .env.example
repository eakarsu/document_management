NODE_ENV=production
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/REPLACE_DATABASE
POSTGRES_IMAGE_TAG=16.3-alpine3.20
POSTGRES_DB=REPLACE_DATABASE
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE

JWT_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32_OR_MORE_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h
AUDIT_SIGNING_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
AUDIT_SIGNING_KEY_ID=REPLACE_WITH_KMS_KEY_VERSION

MINIO_IMAGE_TAG=REPLACE_WITH_REVIEWED_PINNED_TAG
OBJECT_STORAGE_ENDPOINT=https://objects.example.invalid
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
OBJECT_STORAGE_BUCKET=dms-documents
OBJECT_STORAGE_REGION=us-east-1
MALWARE_SCANNER_URL=https://scanner.example.invalid/v1/scan
MALWARE_SCANNER_HEALTH_URL=https://scanner.example.invalid/health/ready
DEFAULT_RETENTION_DAYS=2555

ALLOWED_ORIGINS=https://dms.example.invalid
FRONTEND_URL=https://dms.example.invalid
BACKEND_URL=http://app:4000
NEXT_PUBLIC_API_URL=https://dms.example.invalid
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
OPENROUTER_API_KEY=
OPENROUTER_MODEL_VERSION=REPLACE_WITH_PINNED_PROVIDER_VERSION

# Destructive/administrative actions are opt-in and never used by normal start.
MIGRATION_BACKUP_CONFIRMED=false
ALLOW_DEMO_SEED=false
